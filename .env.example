# MUSAI — environment template. PLACEHOLDERS ONLY.
# Copy to .env (gitignored) locally, or add as Replit Secrets in the cloud.
# NEVER put real values in this file or commit a real .env.

# ── Database ──────────────────────────────────────────────────────────────
# On Replit: DATABASE_URL is injected automatically by the native Postgres add-on.
# Add the Postgres add-on in your Repl → it sets DATABASE_URL for you.
# DATABASE_URL_READONLY must be set manually (susai_ro role with restricted grants).
#
# Locally (dev): leave both unset → app falls back to SQLite (musai_dev.db).
DATABASE_URL=postgresql://REPLIT_INJECTED_AUTOMATICALLY
DATABASE_URL_READONLY=postgresql://susai_ro:CHANGEME@HOST/DBNAME

# ── UACH credentials (Moodle + SEGA) ──────────────────────────────────────
# If Moodle and SEGA share SSO, reuse the same values.
UACH_USERNAME=your_uach_user
UACH_PASSWORD=your_uach_pass
# Optional separate SEGA creds if they differ from the above:
# SEGA_USERNAME=
# SEGA_PASSWORD=
#
# ── Acting as ANOTHER professor (coordinator work only) ───────────────────
# `--as-user <username>` on the backup/restore CLIs reads the password from
# MOODLE_PWD_<USERNAME>. Nothing else in MUSAI touches these, and the value is never
# printed, logged or put in a repr — `musai/automation/credentials.py`.
#
# 🔴 Setting one of these does not make it consented. Moodle records the PROFESSOR as the
# author of everything done through her account, so MUSAI's audit row carries `on_behalf_of`
# because Moodle cannot. Get her agreement for THIS semester, and delete the line when the
# job is done — a password still sitting here in December is not consent from August.
# MOODLE_PWD_COLLEAGUE1=
# MOODLE_PWD_COLLEAGUE2=

# ── Moodle hosts (two environments, one adapter) ──────────────────────────
MOODLE_BASE_URL_STAGING=https://capacitacion.uach.mx
MOODLE_BASE_URL_PROD=https://campusvirtual.uach.mx
SEGA_BASE_URL=https://CHANGEME.uach.mx

# ── Gemini (free tier for v1) ─────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_key
GEMINI_MODEL=gemini-2.5-flash-lite

# ── WhatsApp Cloud API (Meta) — SUSAI ─────────────────────────────────────
WHATSAPP_VERIFY_TOKEN=invent_a_random_string
WHATSAPP_ACCESS_TOKEN=meta_access_token
WHATSAPP_PHONE_NUMBER_ID=meta_phone_number_id
WHATSAPP_APP_SECRET=meta_app_secret_for_signature_check
GRAPH_API_VERSION=v23.0

# ── Google OAuth (professor login) — LIVE since 2026-08-13 ────────────────
# See AUTH_SETUP.md. 🔴 Without all three of CLIENT_ID / CLIENT_SECRET / SESSION_SECRET the
# cockpit fails CLOSED: the landing page still renders and names what is missing, but every
# other route answers 503. That is deliberate — a misconfigured deploy must not fall open.
# Paste the two values from the downloaded client_secret_*.json, then DELETE that file
# (or keep it out of the repo — .env is the only place a real secret belongs).
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Signs the session cookie. Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
SESSION_SECRET=random_session_secret
# Hard gate: only this domain may sign in. Verified server-side, not just via Google's `hd`.
ALLOWED_EMAIL_DOMAIN=uach.mx
ADMIN_EMAIL=professor@uach.mx
# Public origin in prod (e.g. https://musai.replit.app). Empty locally → derived from the
# request, which is what makes localhost:8000 and 127.0.0.1:8000 both work.
APP_BASE_URL=

# ── Recovery: getting back in when the university's account is the problem ────
# 🔴 ADMIN_EMAIL above is an INSTITUTIONAL address. The university can reset or close it, and
# that is ordinary IT housekeeping, not an attack — but it would lock MUSAI's author out of
# MUSAI. These are the two ways back in. Both are OPTIONAL and both ship EMPTY.
#
# 1. A personal Google account, allow-listed by exact address. It needs NO second OAuth client:
#    the existing one authenticates any Google account, and `hd=` only pre-filters the chooser.
#    🔴 Exact whole addresses, comma-separated — NEVER a bare domain. `gmail.com` here would
#    open MUSAI to the planet. These sign in *as* ADMIN_EMAIL (an alias for the owner, not a
#    second account — a second account would own zero courses and land in an empty cockpit).
ADMIN_RECOVERY_EMAILS=
#
# 2. A password door at /auth/break-glass, involving no third party at all. It covers what (1)
#    cannot: the OAuth *client* being lost with the Cloud project that holds it. Generate both
#    values — the password is printed ONCE and MUSAI never stores it — with:
#        python -m musai.security.breakglass
#    Leave either blank and the route answers 404 rather than advertising a door nobody set up.
BREAK_GLASS_EMAIL=
BREAK_GLASS_PASSWORD_HASH=

# ── App ───────────────────────────────────────────────────────────────────
COCKPIT_PASSWORD=set_a_password_for_the_professor_cockpit
APP_SECRET_KEY=random_session_secret
TIMEZONE=America/Chihuahua
# Global safety default — keep true; real writes are explicit human actions.
DRY_RUN=true
